rules_version = '2';

// =====================================================================
// टॉयलेट सेवा — Firestore Security Rules
// Firebase Console → Firestore Database → Rules → paste → Publish
// =====================================================================
// महत्त्वाचे: ॲपमधील admin स्क्रीन ही फक्त UI आहे. खरी सुरक्षा हीच फाइल आहे.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // प्रशासक = Firebase Auth ने पडताळलेला हा एकच ईमेल
    // टीप: Console मधून तयार केलेल्या वापरकर्त्याचा email_verified हा false असतो,
    // म्हणून तो इथे तपासलेला नाही. ईमेल verify केल्यावर हवे असल्यास जोडा:
    //   && request.auth.token.email_verified == true
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'admin@toiletseva.com';
    }

    // ⚠️ एकदाच वापरायचा स्विच.
    // पहिल्या लोडला ॲप 10 नमुना टॉयलेट भरते. ते झाल्यावर हे false करा
    // आणि Rules पुन्हा Publish करा — नाहीतर कोणीही टॉयलेट जोडू शकेल.
    function seedingOpen() {
      return true;
    }

    function isValidToilet(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() < 200
          && d.area is string && d.area.size() < 200
          && d.lat is number && d.lat >= -90  && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.open is bool;
    }

    // नागरिक फक्त rating व votes बदलू शकतो (मानांकन देताना) — बाकी काहीही नाही
    function onlyRatingFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['rating', 'votes'])
          && request.resource.data.rating >= 0
          && request.resource.data.rating <= 5
          && request.resource.data.votes >= resource.data.votes;
    }

    // ---------------- toilets: सर्वांना वाचता येते ----------------
    match /toilets/{toiletId} {
      allow read:   if true;
      allow create: if (seedingOpen() || isAdmin()) && isValidToilet(request.resource.data);
      allow update: if isAdmin() || onlyRatingFields();
      allow delete: if isAdmin();
    }

    // ---------------- complaints: नागरिक नोंदवतो, प्रशासक पाहतो ----------------
    match /complaints/{complaintId} {
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      allow create: if request.resource.data.toiletId is string
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.status == 'open'
                    && request.resource.data.resolvedAt == null
                    // फोटो नसेल किंवा 1 MiB च्या आत असेल
                    && (request.resource.data.photo == null
                        || request.resource.data.photo.size() < 900000);
    }

    // ---------------- ratings: प्रति उपकरण एकच नोंद ----------------
    // doc id = "{toiletId}_{deviceId}", त्यामुळे पुन्हा मानांकन दिल्यास तीच नोंद बदलते
    match /ratings/{ratingId} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.value is int
                            && request.resource.data.value >= 1
                            && request.resource.data.value <= 5
                            && request.resource.data.toiletId is string
                            && ratingId == request.resource.data.toiletId
                                           + '_' + request.resource.data.deviceId;
      allow delete: if isAdmin();
    }

    // बाकी सर्व नाकारा
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
